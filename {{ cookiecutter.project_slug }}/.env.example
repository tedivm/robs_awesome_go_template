# Use __ (double underscore) for nesting: APP_SECTION__FIELD_NAME
{% if cookiecutter.include_web == "y" %}
# Server
APP_SERVER__PORT=8080
APP_SERVER__ENVIRONMENT=development

{% endif %}{% if cookiecutter.include_orm == "y" %}
# Database — SQLite works out of the box. Switch to postgres for production.
APP_DATABASE__DRIVER=sqlite
APP_DATABASE__DSN=./app.db
# For PostgreSQL, uncomment and configure:
# APP_DATABASE__DRIVER=postgres
# APP_DATABASE__DSN=host=localhost user=postgres password=postgres dbname={{ cookiecutter.project_slug }} port=5432 sslmode=disable
APP_DATABASE__MAX_OPEN_CONNS=25
APP_DATABASE__MAX_IDLE_CONNS=5
APP_DATABASE__CONN_MAX_LIFETIME=3600
{% endif %}

{% if cookiecutter.include_workers == "y" %}
# Redis (for Asynq)
APP_REDIS__ADDR=localhost:6379
{% endif %}

# Logging
APP_LOG__LEVEL=debug

{% if cookiecutter.include_web == "y" %}
# Auth
# auth_method: "api_key" (default) or "none" (disable authentication entirely)
APP_AUTH__AUTH_METHOD=api_key
# Set a JWT secret for authentication. Use a strong random value in production.
APP_AUTH__JWT_SECRET=change-me-in-production
# Set the API key that clients use to obtain JWT tokens via /api/v1/auth/login.
APP_AUTH__API_KEY=change-me-in-production

# CORS
APP_CORS__ALLOWED_ORIGINS=*
{% endif %}

{% if cookiecutter.include_docker == "y" %}
# Docker Compose dev database password
DEV_DB_PASSWORD=postgres
{% endif %}
